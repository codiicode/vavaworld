NEXT_PUBLIC_MAPBOX_TOKEN=pk.replace_me
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_PROGRAM_ID=G8MsXTtabmQnfPd4PZ7dDLYtRPhFDqRs93ExhhsSDkwM
NEXT_PUBLIC_TREASURY=YOUR_DEVNET_WALLET_ADDRESS
NEXT_PUBLIC_PRIVY_APP_ID=YOUR_PRIVY_APP_ID

# Optional. Mapillary Graph API client token (format: MLY|app_id|client_token).
# Register at https://www.mapillary.com/dashboard/developers → Register Application
# → grant "Read access" → copy the Client Token. Add it here to enable the
# Street View button on /marketplace/[id]. Without it, the button is hidden.
NEXT_PUBLIC_MAPILLARY_TOKEN=

# Privy server-side app secret (dashboard.privy.io -> Settings -> API keys)
# Required for X (Twitter) verification via /api/verify-x
PRIVY_APP_SECRET=

# ── Solana payment rail (optional; off until BOTH are set) ─────────────
# Users pay SOL/USDC on Solana; the keeper funds their Robinhood wallet with
# the equivalent ETH and their own wallet settles. Flip on without a deploy.
NEXT_PUBLIC_SOLANA_PAY=0
NEXT_PUBLIC_SOLANA_TREASURY=            # Solana address that receives payments
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet      # or devnet for rehearsal
# Server-side RPC for verification (a paid endpoint avoids public rate limits)
SOLANA_RPC_URL=
